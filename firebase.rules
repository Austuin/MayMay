rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function family(f) { return /databases/$(database)/documents/families/$(f); }
    function member(f, u) { return /databases/$(database)/documents/families/$(f)/memberships/$(u); }
    function joinSettings(f) { return /databases/$(database)/documents/families/$(f)/joinSettings/current; }
    function patient(f, p) { return /databases/$(database)/documents/families/$(f)/children/$(p); }
    function access(f, p, u) { return /databases/$(database)/documents/families/$(f)/children/$(p)/access/$(u); }
    function active(f) {
      return signedIn() && exists(member(f, request.auth.uid))
        && get(member(f, request.auth.uid)).data.status == 'Active';
    }
    function primary(f) {
      return active(f) && get(member(f, request.auth.uid)).data.role == 'Primary';
    }
    function permitted(f, p) {
      return active(f) && exists(patient(f, p)) && exists(access(f, p, request.auth.uid))
        && get(access(f, p, request.auth.uid)).data.canAccess == true;
    }
    function canWrite(f, p) {
      return permitted(f, p)
        && get(member(f, request.auth.uid)).data.role in ['Primary', 'Caregiver'];
    }
    function activePrimaryAfter(f, u) {
      return existsAfter(member(f, u))
        && getAfter(member(f, u)).data.status == 'Active'
        && getAfter(member(f, u)).data.role == 'Primary';
    }
    function validMembership(f, u) {
      return request.resource.data.keys().hasOnly(['familyId', 'userId', 'role', 'status', 'requestedAt', 'dateJoined', 'approvedAt', 'approvedBy', 'reviewedAt', 'reviewedBy', 'patientIds', 'requesterName', 'requesterEmail', 'joinSecret'])
        && request.resource.data.familyId == f && request.resource.data.userId == u
        && request.resource.data.role in ['Primary', 'Caregiver', 'Viewer']
        && request.resource.data.status in ['Pending', 'Active', 'Rejected', 'Disabled']
        && request.resource.data.get('patientIds', []) is list;
    }
    function validJoinRequest(f, u) {
      return signedIn() && request.auth.uid == u
        && exists(family(f))
        && request.resource.data.keys().hasOnly(['familyId', 'userId', 'role', 'status', 'requestedAt', 'patientIds', 'requesterName', 'requesterEmail', 'joinSecret'])
        && request.resource.data.role == 'Caregiver'
        && request.resource.data.status == 'Pending'
        && request.resource.data.patientIds == []
        && request.resource.data.requesterName is string
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.requestedAt == request.time
        && request.resource.data.joinSecret == get(joinSettings(f)).data.secret;
    }
    function validPatient(f, p) {
      return request.resource.data.keys().hasOnly(['patientId', 'familyId', 'name', 'dateCreated', 'dateUpdated', 'age', 'sex', 'ethnicity', 'autismLevel', 'birthdate'])
        && request.resource.data.patientId == p
        && request.resource.data.familyId == f
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.get('age', 0) is int
        && request.resource.data.get('age', 0) >= 0
        && request.resource.data.get('age', 0) <= 120
        && request.resource.data.get('sex', '') is string
        && request.resource.data.get('ethnicity', '') is string
        && request.resource.data.get('autismLevel', '') is string
        && request.resource.data.get('birthdate', '') is string;
    }
    function validAccess(f, p, u) {
      return request.resource.data.keys().hasOnly(['familyId', 'patientId', 'userId', 'relationship', 'canAccess'])
        && request.resource.data.familyId == f && request.resource.data.patientId == p
        && request.resource.data.userId == u && request.resource.data.relationship is string
        && request.resource.data.canAccess is bool;
    }
    match /system/{document=**} { allow read, write: if false; }
    // Identity is independent of family membership and grants no care access.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'name', 'email', 'dateCreated', 'dateUpdated', 'familyIds'])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('familyIds', []) is list;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'dateUpdated', 'familyIds'])
        && request.resource.data.get('familyIds', []) is list;
      allow delete: if false;
      match /days/{dayId} { allow read, write: if false; }
    }
    match /families/{familyId} {
      // Family creation and first Primary membership form one atomic batch.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'name', 'creatorId', 'primaryId', 'dateCreated'])
        && request.resource.data.familyId == familyId
        && request.resource.data.name is string
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.primaryId == request.auth.uid
        && activePrimaryAfter(familyId, request.auth.uid);
      allow read: if active(familyId);
      // The designated Primary must always remain active. A transfer must name
      // another active Primary in the post-commit state.
      allow update: if primary(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'primaryId'])
        && activePrimaryAfter(familyId, request.resource.data.primaryId);
      allow delete: if false;
      match /joinSettings/{settingsId} {
        allow get: if settingsId == 'current' && primary(familyId);
        allow list: if false;
        allow create, update: if settingsId == 'current' && primary(familyId)
          && request.resource.data.keys().hasOnly(['familyId', 'secret', 'updatedAt'])
          && request.resource.data.familyId == familyId
          && request.resource.data.secret is string
          && request.resource.data.secret.matches('^[0-9a-f]{32}$')
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /memberships/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || primary(familyId));
        allow create: if validMembership(familyId, userId)
          && ((signedIn() && request.auth.uid == userId
              && !exists(family(familyId))
              && getAfter(family(familyId)).data.creatorId == userId
              && getAfter(family(familyId)).data.primaryId == userId
              && request.resource.data.role == 'Primary'
              && request.resource.data.status == 'Active')
            || validJoinRequest(familyId, userId));
        allow update: if validMembership(familyId, userId)
          && ((primary(familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.userId == resource.data.userId
          && (request.resource.data.role != 'Primary' || request.resource.data.status == 'Active')
          && (request.resource.data.role != 'Primary'
            || resource.data.role == 'Primary' || resource.data.status == 'Active')
          && (getAfter(family(familyId)).data.primaryId != userId
            || (request.resource.data.role == 'Primary' && request.resource.data.status == 'Active')))
          || (resource.data.status == 'Rejected' && validJoinRequest(familyId, userId)));
        allow delete: if (primary(familyId)
          && getAfter(family(familyId)).data.primaryId != userId)
          || (signedIn() && request.auth.uid == userId && resource.data.status == 'Pending');
      }
      // "children" remains the care-record collection name until the rollout.
      // Each document is a patient record with its own access subcollection.
      match /children/{patientId} {
        allow read: if permitted(familyId, patientId);
        allow create: if primary(familyId) && validPatient(familyId, patientId)
          && getAfter(access(familyId, patientId, request.auth.uid)).data.canAccess == true;
        allow update: if primary(familyId)
          && validPatient(familyId, patientId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'dateUpdated', 'age', 'sex', 'ethnicity', 'autismLevel', 'birthdate']);
        allow delete: if false;
        match /access/{userId} {
          allow read: if primary(familyId) || (signedIn() && request.auth.uid == userId && active(familyId));
          allow create, update: if primary(familyId) && validAccess(familyId, patientId, userId)
            && existsAfter(patient(familyId, patientId))
            && exists(member(familyId, userId))
            && (request.resource.data.canAccess == false
              || getAfter(member(familyId, userId)).data.status == 'Active');
          allow delete: if primary(familyId);
        }
        match /medications/{medicationId} {
          allow read: if permitted(familyId, patientId);
          allow create, update: if primary(familyId) && permitted(familyId, patientId);
          allow delete: if false;
        }
        match /events/{eventId} {
          function hasSaveReceipt() {
            let mutationId = request.resource.data.mutationId;
            let receipt = getAfter(/databases/$(database)/documents/families/$(familyId)/children/$(patientId)/events/$(eventId)/mutations/$(mutationId)).data;
            return request.resource.data.syncVersion == 2
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
              && receipt.createdBy == request.auth.uid
              && receipt.createdAt == request.time
              && receipt.commitId == mutationId
              && receipt.revision == request.resource.data.revision;
          }
          allow read: if permitted(familyId, patientId);
          allow create: if canWrite(familyId, patientId) && hasSaveReceipt()
            && request.resource.data.revision == 1
            && request.resource.data.schemaVersion == 1
            && request.resource.data.childId == patientId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.type in ['mood', 'trigger', 'meltdown', 'meal', 'bathroom', 'medication', 'sleep', 'health', 'routine', 'note']
            && request.resource.data.localDate is string
            && request.resource.data.occurredAt is timestamp
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.data is map;
          allow update: if canWrite(familyId, patientId) && hasSaveReceipt()
            && request.resource.data.revision == resource.data.get('revision', 0) + 1
            && request.resource.data.schemaVersion == 1
            && request.resource.data.childId == resource.data.childId
            && request.resource.data.type == resource.data.type
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.localDate == resource.data.localDate
            && request.resource.data.occurredAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.data is map;
          allow delete: if false;
          match /mutations/{mutationId} {
            allow read: if permitted(familyId, patientId);
            allow create: if canWrite(familyId, patientId)
              && request.resource.data.keys().hasOnly(['commitId', 'revision', 'createdBy', 'createdAt'])
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.createdAt == request.time
              && request.resource.data.revision is int
              && getAfter(/databases/$(database)/documents/families/$(familyId)/children/$(patientId)/events/$(eventId)).data.mutationId == request.resource.data.commitId
              && getAfter(/databases/$(database)/documents/families/$(familyId)/children/$(patientId)/events/$(eventId)).data.revision == request.resource.data.revision
              && getAfter(/databases/$(database)/documents/families/$(familyId)/children/$(patientId)/events/$(eventId)).data.updatedBy == request.auth.uid
              && getAfter(/databases/$(database)/documents/families/$(familyId)/children/$(patientId)/events/$(eventId)).data.updatedAt == request.time;
            allow update, delete: if false;
          }
        }
        match /daySummaries/{dayId} {
          allow read: if permitted(familyId, patientId);
          allow create, update: if canWrite(familyId, patientId)
            && request.resource.data.schemaVersion == 1
            && request.resource.data.childId == patientId
            && request.resource.data.localDate == dayId;
          allow delete: if false;
        }
      }
    }
  }
}
