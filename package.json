{
  "name": "maymay",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:network": "vinext dev --hostname 0.0.0.0",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "host": "node scripts/host-terminal.mjs",
    "firebase:reset-plan": "node scripts/reset-activate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:rules": "firebase emulators:exec --only firestore --project demo-maymay-test --config firebase.test.json \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "lucide-react": "1.31.0",
    "multicast-dns": "^7.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261001.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.32.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^5.0.0",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "fflate@0.7.3": "0.7.5",
    "gaxios@6.7.1": { "uuid": "11.1.1" }
  },
  "type": "module"
}
